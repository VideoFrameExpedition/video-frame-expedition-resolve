# Copy as `.env` at the root of the repository for run.bat or run.command (in `backend/` for
# `just dev-backend`), or define these variables in the environment.
# The user preferences (models, prompts, steps, online services…) are set in the interface.

# --- Language of the terminal's messages (run.bat, run.command, installation scripts, vfe) ---
# By default: French on a system set to French, English otherwise. The web interface has its own
# language switch.
# VFE_LANG=fr

# --- Server ---
VFE_HOST=127.0.0.1
VFE_PORT=8765
# Required if VFE_HOST is not a loopback address
# VFE_API_TOKEN=

# --- Access from your other devices (Tailscale) ---
# Also listens on the Tailscale address of this computer (found at start-up), without ever
# listening on the whole local network. A token is then asked of the other devices: it is
# created at the first start (`vfe token` shows it, see "Command line" in README.md).
# Firewall: see docs/guide/connect-mcp.md.
# VFE_TAILSCALE=true
# Or precise addresses (IP only, separated by commas):
# VFE_EXTRA_HOSTS=100.64.12.34
# Path of tailscale.exe if it is neither in the PATH nor in C:\Program Files\Tailscale (on a
# Mac: of the tailscale command, if it is neither in the PATH, nor in Tailscale.app, nor in
# Homebrew's folder)
# VFE_TAILSCALE_PATH=

# --- Data of the application (default: %LOCALAPPDATA%\vfe-vision; on a Mac,
# ~/Library/Application Support/vfe-vision) ---
# VFE_DATA_DIR=D:\vfe-vision-data
# VFE_DATA_DIR=/Volumes/Data/vfe-vision

# --- External tools (default: looked up in the PATH; on a Mac, also in Homebrew's folders,
# ffmpeg-full first) ---
# VFE_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# VFE_FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# VFE_EXIFTOOL_PATH=C:\Users\me\AppData\Local\Programs\ExifTool\ExifTool.exe
# VFE_FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg

# --- DaVinci Resolve's scripting library (default: the one of Resolve's installation) ---
# VFE_RESOLVE_SCRIPT_LIB=/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/Fusion/fusionscript.so

# --- Model server (LM Studio, or a server compatible with OpenAI's API: vLLM…) ---
# The address used as long as no other one is chosen in the interface (System page, "Model
# server" card): that is where another server is set, without restarting. The address of an
# OpenAI-compatible server is written with its path: http://gpu-box:8000/v1
VFE_LMSTUDIO_URL=http://127.0.0.1:1234
# API token of that server (LM Studio: Developer → API tokens; vLLM: --api-key), if enabled;
# sent to the address above only
# VFE_LMSTUDIO_TOKEN=
# Kind of server at that address: auto (found out, LM Studio first), lmstudio or openai
# VFE_MODEL_SERVER=auto
# OpenAI-compatible server: requests sent at once (1 to 32; 4 to 8 let vLLM batch the frames)
# VFE_MODEL_SERVER_PARALLEL=4
# OpenAI-compatible server: whether its models see images
# VFE_MODEL_SERVER_VISION=true

# --- Logging ---
VFE_LOG_LEVEL=INFO
# json | console
VFE_LOG_FORMAT=console
